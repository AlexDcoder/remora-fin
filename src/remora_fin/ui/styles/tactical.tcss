/* Remora tactical dashboard. Cyan is reserved for actions and selected rows. */
Screen { background: #0d0e12; color: #a0a8b6; }
DashboardScreen {
    layout: vertical;
    background: #0d0e12;
}
Footer { background: #0a0a0a; color: #6e7681; }
Footer > .footer--key { background: #16181d; color: #a0a8b6; }

.status-bar {
    width: 100%;
    height: 4;
    padding: 0 2;
    background: #121418;
    border-bottom: solid #2a2e37;
    align: left middle;
}
.breadcrumbs { width: 1fr; height: 1; color: #ffffff; text-style: bold; }
.status-pill {
    width: auto;
    height: 3;
    margin-left: 1;
    padding: 0 1;
    background: #16181d;
    border: solid #333742;
    color: #a0a8b6;
    text-style: bold;
}
.status-pill.okay { color: #00e676; }
.status-pill.warning { color: #ffb300; }
.status-pill.error { color: #ff5252; }
.status-pill.accent { color: #42e3f5; }

.page-heading { width: 100%; height: 4; padding: 0 2; }
.page-title { height: 1; color: #ffffff; text-style: bold; }
.page-subtitle, .status-context { height: 1; color: #6e7681; }

DashboardWidget {
    width: 100%;
    height: 1fr;
    padding: 0 2 1 2;
    background: #0d0e12;
    overflow-y: auto;
}
.panel, .kpi-card { background: #121418; border: solid #2a2e37; }
.section-title { color: #ffffff; text-style: bold; }

#control-row {
    width: 100%;
    height: 5;
    padding: 0 1;
    margin-bottom: 1;
    align: left middle;
}
#filter-label { width: auto; margin-right: 2; color: #8b949e; text-style: bold; }
#service-selector { width: 1fr; }
#view-toggle, #recommendations-toggle { width: 20; min-width: 20; margin-left: 1; }

#kpi-row { width: 100%; height: 8; margin-bottom: 1; }
.kpi-card {
    width: 1fr;
    min-width: 17;
    height: 8;
    margin-right: 1;
    padding: 1 2;
}
#kpi-savings { margin-right: 0; }
.kpi-index { dock: right; width: 3; color: #333742; text-style: bold; }
.kpi-label { height: 1; color: #8b949e; text-style: bold; }
.kpi-value { height: 2; margin-top: 1; color: #ffffff; text-style: bold; }
.kpi-card.warning .kpi-value { color: #ffb300; }
.kpi-card.danger .kpi-value { color: #ff5252; }

#service-status-header {
    width: 100%;
    height: 2;
    padding: 0 1;
    color: #8b949e;
    background: #16181d;
    border-left: solid #2a2e37;
    border-right: solid #2a2e37;
    text-style: bold;
}
#dashboard-content-switcher { width: 100%; height: 18; margin-bottom: 1; }
CostChartWidget { width: 100%; height: 100%; padding: 1 2; overflow-y: auto; }
#dashboard-report-table { width: 100%; height: 100%; }
#dashboard-recommendations-table { width: 100%; height: 100%; }

DataTable { background: #121418; color: #a0a8b6; border: solid #2a2e37; }
DataTable > .datatable--header { background: #16181d; color: #ffffff; text-style: bold; }
DataTable > .datatable--cursor { background: #42e3f5; color: #0a0a0a; text-style: bold; }
DataTable > .datatable--hover { background: #22272e; }

Button {
    height: 3;
    min-width: 10;
    background: #16181d;
    color: #ffffff;
    border: solid #333742;
    text-style: bold;
}
Button.primary-action, Button.-primary { background: #42e3f5; color: #0a0a0a; border: none; }
Button.primary-action:hover, Button.-primary:hover { background: #73eef9; color: #0a0a0a; }
Button.secondary-action:hover { background: #22272e; }

Input { height: 3; background: #16181d; color: #ffffff; border: solid #333742; }
Input:focus { border: solid #42e3f5; }
Input > .input--placeholder { color: #6e7681; }
Select { height: 3; background: transparent; color: #ffffff; border: none; }
Select > SelectCurrent {
    height: 3;
    padding: 0 1;
    background: #16181d;
    color: #ffffff;
    border: solid #333742;
}
Select > SelectCurrent Static#label { color: #8b949e; }
Select > SelectCurrent.-has-value Static#label { color: #ffffff; }
Select > SelectCurrent .arrow { color: #42e3f5; }
Select:focus > SelectCurrent { background: #1c2026; border: solid #42e3f5; }
Select > SelectOverlay {
    max-height: 16;
    background: #16181d;
    color: #ffffff;
    border: solid #333742;
}
Select > SelectOverlay > .option-list--option {
    background: #16181d;
    color: #ffffff;
}
Select > SelectOverlay > .option-list--option-highlighted,
Select > SelectOverlay:focus > .option-list--option-highlighted,
Select > SelectOverlay > .option-list--option-hover {
    background: #42e3f5;
    color: #0a0a0a;
    text-style: bold;
}

ProgressBar { height: 1; }
ProgressBar Bar { height: 1; width: 1fr; }
.usage-low Bar > .bar--bar { color: #42e3f5; background: #2a2e37; }
.usage-medium Bar > .bar--bar { color: #ffb300; background: #2a2e37; }
.usage-high Bar > .bar--bar { color: #ff5252; background: #2a2e37; }

.log-panel {
    width: 100%;
    height: 7;
    padding: 0 1;
    background: #0a0a0a;
    border: solid #2a2e37;
}
.log-heading { height: 1; color: #ffffff; text-style: bold; }
.log-stream { height: 1fr; background: #0a0a0a; color: #a0a8b6; }

.error-banner { background: #2a181a; color: #ff5252; border: solid #5a3035; padding: 0 1; }
.success-banner { background: #12251d; color: #00e676; border: solid #27513b; padding: 0 1; }

AnomalyPanel, ForecastPanel { width: 100%; height: 1fr; padding: 1 2; background: #0d0e12; }
AnomalyDetailCard, AccuracyMeter {
    background: #121418;
    border: solid #2a2e37;
    padding: 1 2;
    margin: 1 0;
}
